{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fullpos-windows-preflight",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/fullpos_windows_preflight.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/fulltech_app"
      },
      "problemMatcher": []
    },
    {
      "label": "fullpos-flutter-pub-get",
      "type": "shell",
      "command": "flutter",
      "args": [
        "pub",
        "get"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/fulltech_app"
      },
      "problemMatcher": []
    },
    {
      "label": "fullpos-flutter-analyze",
      "type": "shell",
      "command": "flutter",
      "args": [
        "analyze"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/fulltech_app"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "fullpos-test-cotizaciones",
      "type": "shell",
      "command": "flutter",
      "args": [
        "test",
        "test/modules/cotizaciones"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/fulltech_app"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "fullpos-build-windows-release",
      "type": "shell",
      "command": "flutter",
      "args": [
        "build",
        "windows",
        "--release"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/fulltech_app"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
