{
  "name": "@daleventa-pos/api",
  "private": true,
  "version": "0.0.1",
  "main": "dist/main.js",
  "scripts": {
    "prestart": "prisma migrate deploy",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=\\.spec\\.ts$",
    "test:integration": "jest --runInBand --testPathPattern=\\.integration-spec\\.ts$",
    "test:e2e": "jest --runInBand --testPathPattern=\\.e2e-spec\\.ts$",
    "test:security": "jest --runInBand --testPathPattern=security",
    "test:tenant": "jest --runInBand --testPathPattern=tenant",
    "test:deletion": "jest --runInBand --testPathPattern=deletion",
    "audit:tenant-inventory": "ts-node scripts/generate-tenant-inventory.ts",
    "audit:endpoints": "ts-node scripts/generate-endpoint-security-matrix.ts",
    "audit:tenant-ownership": "ts-node scripts/audit-tenant-ownership.ts",
    "audit:tenant-ownership:apply": "ts-node scripts/audit-tenant-ownership.ts --apply",
    "backfill:tenant-ownership": "ts-node scripts/backfill-tenant-ownership.ts",
    "audit:unsafe-tenant-queries": "ts-node scripts/audit-unsafe-tenant-queries.ts",
    "audit:unsafe-tenant-queries:warn": "ts-node scripts/audit-unsafe-tenant-queries.ts --warn-only",
    "prisma": "prisma",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "integrity:check": "ts-node prisma/scripts/fix_integrity.ts --check",
    "integrity:fix": "ts-node prisma/scripts/fix_integrity.ts --fix",
    "test:integration:users": "ts-node scripts/integration-users-get.ts",
    "test:smoke:reservation-reminder": "ts-node scripts/smoke-reservation-reminder.ts",
    "test:smoke:service-orders": "node scripts/smoke-service-orders.cjs",
    "test:smoke:service-orders:http": "node scripts/smoke-service-orders-http.cjs",
    "db:purge:clients-service-orders": "ts-node scripts/purge-clients-service-orders.ts",
    "db:purge:employee-warnings": "ts-node scripts/purge-employee-warnings.ts",
    "auth:reset-password": "node scripts/reset-password.cjs",
    "test:smoke": "ts-node scripts/smoke-test.ts",
    "whatsapp:inbox:repair": "ts-node scripts/repair-whatsapp-inbox-duplicates.ts",
    "whatsapp:inbox:repair:execute": "ts-node scripts/repair-whatsapp-inbox-duplicates.ts --execute",
    "whatsapp:media:audit": "ts-node scripts/audit-whatsapp-media.ts",
    "whatsapp:media:repair": "ts-node scripts/audit-whatsapp-media.ts --execute",
    "whatsapp:media:debug": "ts-node scripts/debug-whatsapp-media.ts",
    "media:migrate:r2": "ts-node scripts/migrate-local-media-to-r2.ts",
    "media:migrate:r2:dry-run": "ts-node scripts/migrate-local-media-to-r2.ts --dry-run",
    "reset-whatsapp-inbox-data": "ts-node scripts/reset-whatsapp-inbox-data.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@aws-crypto/crc32c": "^5.2.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^5.22.0",
    "@types/pg": "^8.18.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
