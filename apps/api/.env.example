DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
PORT=4000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
# Nombre sugerido del volumen Docker para los uploads
# (ajusta en docker-compose si cambias el nombre)
UPLOAD_VOLUME_NAME=uploads_data
STORAGE_MODE=none
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
REDIS_TTL_DEFAULT=60
REDIS_PREFIX=daleventa_pos

# Password reset email (OWNER accounts only)
# Provider supported by the API without extra packages: Resend.
PASSWORD_RESET_URL_BASE=https://fullposcloud.fulltechrd.com
RESEND_API_KEY=
EMAIL_FROM="FullPOS Cloud <no-reply@example.com>"

# Storage (R2 / presigned uploads)
# Necesario para /storage/presign + /storage/confirm (subida directa al bucket desde Flutter).
#
# Nota (Web/PWA): si la app web hace PUT directo al bucket usando la URL presignada,
# el bucket debe tener CORS permitido para el dominio de la PWA (PUT + header Content-Type).
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Base pública para construir URLs de lectura (ideal: custom domain HTTPS del bucket/CDN)
R2_PUBLIC_BASE_URL=

# Límites (bytes) y expiración presign (segundos)
STORAGE_IMAGE_MAX_BYTES=5242880
STORAGE_VIDEO_MAX_BYTES=20971520
STORAGE_DOCUMENT_MAX_BYTES=10485760
STORAGE_PRESIGN_EXPIRES_SECONDS=900

# Seed (opcional)
ADMIN_EMAIL=admin@daleventa.local
ADMIN_PASSWORD=change-me
RUN_SEED=false

# Startup robustness (EasyPanel / contenedores)
RUN_MIGRATIONS=true
PRISMA_SYNC_MODE=push
MIGRATION_MAX_RETRIES=10
MIGRATION_RETRY_DELAY_SECONDS=5
MIGRATION_STRICT=false

# Telemetria agregada hacia Appyra Admin
# Envia solo contadores por negocio: ventas, caja, productos, clientes y modulos usados.
APPYRA_USAGE_TELEMETRY_ENABLED=true
APPYRA_USAGE_API_BASE_URL=https://TU-DOMINIO-APPYRA.com
APPYRA_USAGE_INGEST_SECRET=
APPYRA_USAGE_TELEMETRY_INTERVAL_MINUTES=30
APPYRA_USAGE_TELEMETRY_COMPANY_LIMIT=250
APPYRA_USAGE_TELEMETRY_TIMEOUT_MS=12000
APPYRA_USAGE_TELEMETRY_TIME_ZONE=America/Santo_Domingo
APPYRA_USAGE_CLIENT_THROTTLE_SECONDS=300
APPYRA_USAGE_CLIENT_ACTIVE_SECONDS=60
APP_VERSION=daleventas-pos-api

# ==========================================
# APPYRA Guardian AI (fail-closed: sin estos valores Guardian queda apagado)
# Documentación completa: docs/guardian/GUARDIAN_EXTERNAL_SETUP.md
# ==========================================
GUARDIAN_ENABLED=false
GUARDIAN_INGEST_ENABLED=false
GUARDIAN_BACKEND_CAPTURE_ENABLED=false
GUARDIAN_DIAGNOSIS_ENABLED=false
GUARDIAN_ALERTS_ENABLED=false
GUARDIAN_MAX_BATCH_EVENTS=20
GUARDIAN_MAX_PAYLOAD_BYTES=65536
GUARDIAN_MAX_STACK_CHARS=20000

# Identidad oficial APPYRA (nunca credenciales Meta de otro producto)
GUARDIAN_WA_CLOUD_TOKEN=
GUARDIAN_WA_PHONE_NUMBER_ID=
GUARDIAN_WA_WABA_ID=
GUARDIAN_WA_DISPLAY_NUMBER=
GUARDIAN_WA_DISPLAY_NAME=APPYRA
GUARDIAN_WA_API_VERSION=v21.0
GUARDIAN_WA_TEMPLATE_NAME=guardian_incident_alert
GUARDIAN_WA_TEMPLATE_LANG=es
GUARDIAN_WA_WATCHDOG_TEMPLATE_NAME=guardian_watchdog_alert
GUARDIAN_WA_APP_SECRET=
GUARDIAN_WA_VERIFY_TOKEN=
GUARDIAN_WA_TIMEOUT_MS=12000

# Destinatarios administrativos (lista separada por comas) y política 24/7
GUARDIAN_ALERT_RECIPIENTS=
GUARDIAN_ALERT_RECIPIENT=
GUARDIAN_ALERT_SEV3_ENABLED=true
GUARDIAN_ALERT_SEV4_ENABLED=false
GUARDIAN_ALERT_GROUP_WINDOW_MINUTES=30
GUARDIAN_ALERT_FALLBACK_WEBHOOK_URL=
GUARDIAN_ALERT_FALLBACK_SECRET=
GUARDIAN_ALERTS_EVOLUTION_ENABLED=false

# Proveedor de IA (solo clave propia de Guardian; nunca OPENAI_API_KEY de otro producto)
# GUARDIAN_AI_PROVIDER: deepseek | openai | mock. Sin definir se infiere por el host
# de GUARDIAN_AI_BASE_URL (api.deepseek.com => deepseek; otro => openai).
# Modelos admitidos de DeepSeek: deepseek-flash, deepseek-v4-pro.
GUARDIAN_AI_PROVIDER=deepseek
GUARDIAN_AI_API_KEY=
GUARDIAN_AI_BASE_URL=https://api.deepseek.com/v1
GUARDIAN_AI_MODEL=deepseek-flash
GUARDIAN_AI_TIMEOUT_MS=20000
GUARDIAN_AI_MAX_TOKENS=900
GUARDIAN_AI_MAX_CONCURRENCY=2
GUARDIAN_AI_TOKENS_PER_COMPANY_DAY=200000
GUARDIAN_DIAGNOSIS_MAX_ATTEMPTS=4
GUARDIAN_CODE_ROOT=

# Operación, acceso de plataforma y workers
GUARDIAN_PLATFORM_TOKEN=
GUARDIAN_READER_DATABASE_URL=
GUARDIAN_WORKER_INTERVAL_SECONDS=5
GUARDIAN_WATCHDOG_DATABASE_URL=
GUARDIAN_WATCHDOG_WEBHOOK_URL=
GUARDIAN_WATCHDOG_WEBHOOK_TOKEN=
GUARDIAN_WATCHDOG_STATE_PATH=
GUARDIAN_WATCHDOG_STUCK_MINUTES=30
GUARDIAN_WATCHDOG_HEARTBEAT_MINUTES=10
GUARDIAN_WATCHDOG_REALERT_MINUTES=60
GUARDIAN_WATCHDOG_SEV1_MINUTES=60
GUARDIAN_WATCHDOG_WORKERS=alerts,diagnosis

# --- DOSA (proveedor e-CF) -------------------------------------------------
# Tres familias de credenciales SEPARADAS. No reutilizar una en el sitio de otra.
#
# 1) Webhook: HMAC sobre el cuerpo original (X-Dosa-Signature: t=...,v1=...).
DOSA_WEBHOOK_ENABLED=false
# BLOCKED (por defecto) | HMAC_SHA256_TIMESTAMPED | UNVERIFIED_PLAINTEXT_SECRET (solo laboratorio local)
DOSA_WEBHOOK_SIGNATURE_STRATEGY=BLOCKED
DOSA_WEBHOOK_SECRET=
# Cómo se interpretan los caracteres de DOSA_WEBHOOK_SECRET. PENDIENTE de confirmar.
#   utf8 (por defecto) -> los 64 caracteres son la clave tal cual
#   hex                -> los 64 caracteres codifican 32 bytes que son la clave
# Elegir mal hace que TODA firma se rechace (falla cerrado, pero sin pistas).
DOSA_WEBHOOK_SECRET_ENCODING=utf8
# Unidad del campo `t` de la cabecera. PENDIENTE de confirmar con el proveedor.
# Valor admitido: seconds | milliseconds. Por defecto seconds.
DOSA_WEBHOOK_TIMESTAMP_UNIT=seconds
# Ventana anti-replay en segundos (por defecto 300; techo 86400).
DOSA_WEBHOOK_TOLERANCE_SECONDS=300
#
# 2) Consultas: cabecera X-Dosa-Secret-Key con la clave secreta `sk_...`.
# Apagado por defecto: no hay endpoints de consulta confirmados.
DOSA_API_QUERIES_ENABLED=false
DOSA_SECRET_KEY=
DOSA_BASE_URL=
DOSA_QUERY_TIMEOUT_MS=15000
#
# 3) Emisión: cabecera X-API-KEY, misma ruta para TEST y produccion.
DOSA_TEST_API_KEY=
DOSA_PRODUCTION_API_KEY=
DOSA_EMISSION_ENABLED=false
DOSA_PRODUCTION_EMISSION_ENABLED=false

# ---------------------------------------------------------------------------
# Acceso al ASISTENTE e-CF (portal de certificación)
# ---------------------------------------------------------------------------
# La elegibilidad ya NO se decide por entorno: se guarda por empresa en
# `ecf_portal_enrollments` (autorización con autor, motivo, contrato y
# caducidad), gestionada desde /ecf/platform/dosa/portal-enrollments/:id.
#
# ECF_PORTAL_PILOT_COMPANY_IDS queda SOLO como compatibilidad: si un despliegue
# la tiene configurada, sus empresas siguen entrando mientras no exista fila en
# la tabla. No se usa para escribir nada y está declarada obsoleta.
ECF_PORTAL_PILOT_COMPANY_IDS=
#
# Inscripción automática: apagada por defecto (falla cerrado). Con `true`, una
# empresa con e-CF habilitado, identidad fiscal registrada y postulación DOSA
# iniciada se autoriza sola. Activar esto es una decisión de negocio.
ECF_PORTAL_AUTO_ENROLL_ENABLED=false
