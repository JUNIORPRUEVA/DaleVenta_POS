DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
PORT=4000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
# Nombre sugerido del volumen Docker para los uploads
# (ajusta en docker-compose si cambias el nombre)
UPLOAD_VOLUME_NAME=uploads_data
STORAGE_MODE=none
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379
REDIS_TTL_DEFAULT=60
REDIS_PREFIX=daleventa_pos

# Password reset email (OWNER accounts only)
# Provider supported by the API without extra packages: Resend.
PASSWORD_RESET_URL_BASE=https://fullposcloud.fulltechrd.com
RESEND_API_KEY=
EMAIL_FROM="FullPOS Cloud <no-reply@example.com>"

# Storage (R2 / presigned uploads)
# Necesario para /storage/presign + /storage/confirm (subida directa al bucket desde Flutter).
#
# Nota (Web/PWA): si la app web hace PUT directo al bucket usando la URL presignada,
# el bucket debe tener CORS permitido para el dominio de la PWA (PUT + header Content-Type).
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Base pública para construir URLs de lectura (ideal: custom domain HTTPS del bucket/CDN)
R2_PUBLIC_BASE_URL=

# Límites (bytes) y expiración presign (segundos)
STORAGE_IMAGE_MAX_BYTES=5242880
STORAGE_VIDEO_MAX_BYTES=20971520
STORAGE_DOCUMENT_MAX_BYTES=10485760
STORAGE_PRESIGN_EXPIRES_SECONDS=900

# Seed (opcional)
ADMIN_EMAIL=admin@daleventa.local
ADMIN_PASSWORD=change-me
RUN_SEED=false

# Startup robustness (EasyPanel / contenedores)
RUN_MIGRATIONS=true
PRISMA_SYNC_MODE=push
MIGRATION_MAX_RETRIES=10
MIGRATION_RETRY_DELAY_SECONDS=5
MIGRATION_STRICT=false

# Telemetria agregada hacia Appyra Admin
# Envia solo contadores por negocio: ventas, caja, productos, clientes y modulos usados.
APPYRA_USAGE_TELEMETRY_ENABLED=true
APPYRA_USAGE_API_BASE_URL=https://TU-DOMINIO-APPYRA.com
APPYRA_USAGE_INGEST_SECRET=
APPYRA_USAGE_TELEMETRY_INTERVAL_MINUTES=30
APPYRA_USAGE_TELEMETRY_COMPANY_LIMIT=250
APPYRA_USAGE_TELEMETRY_TIMEOUT_MS=12000
APPYRA_USAGE_TELEMETRY_TIME_ZONE=America/Santo_Domingo
APPYRA_USAGE_CLIENT_THROTTLE_SECONDS=300
APPYRA_USAGE_CLIENT_ACTIVE_SECONDS=60
APP_VERSION=daleventas-pos-api

# ==========================================
# APPYRA Guardian AI (fail-closed: sin estos valores Guardian queda apagado)
# Documentación completa: docs/guardian/GUARDIAN_EXTERNAL_SETUP.md
# ==========================================
GUARDIAN_ENABLED=false
GUARDIAN_INGEST_ENABLED=false
GUARDIAN_BACKEND_CAPTURE_ENABLED=false
GUARDIAN_DIAGNOSIS_ENABLED=false
GUARDIAN_ALERTS_ENABLED=false
GUARDIAN_MAX_BATCH_EVENTS=20
GUARDIAN_MAX_PAYLOAD_BYTES=65536
GUARDIAN_MAX_STACK_CHARS=20000

# Identidad oficial APPYRA (nunca credenciales Meta de otro producto)
GUARDIAN_WA_CLOUD_TOKEN=
GUARDIAN_WA_PHONE_NUMBER_ID=
GUARDIAN_WA_WABA_ID=
GUARDIAN_WA_DISPLAY_NUMBER=
GUARDIAN_WA_DISPLAY_NAME=APPYRA
GUARDIAN_WA_API_VERSION=v21.0
GUARDIAN_WA_TEMPLATE_NAME=guardian_incident_alert
GUARDIAN_WA_TEMPLATE_LANG=es
GUARDIAN_WA_WATCHDOG_TEMPLATE_NAME=guardian_watchdog_alert
GUARDIAN_WA_APP_SECRET=
GUARDIAN_WA_VERIFY_TOKEN=
GUARDIAN_WA_TIMEOUT_MS=12000

# Destinatarios administrativos (lista separada por comas) y política 24/7
GUARDIAN_ALERT_RECIPIENTS=
GUARDIAN_ALERT_RECIPIENT=
GUARDIAN_ALERT_SEV3_ENABLED=true
GUARDIAN_ALERT_SEV4_ENABLED=false
GUARDIAN_ALERT_GROUP_WINDOW_MINUTES=30
GUARDIAN_ALERT_FALLBACK_WEBHOOK_URL=
GUARDIAN_ALERT_FALLBACK_SECRET=
GUARDIAN_ALERTS_EVOLUTION_ENABLED=false

# Proveedor de IA (solo clave propia de Guardian; nunca OPENAI_API_KEY de otro producto)
# GUARDIAN_AI_PROVIDER: deepseek | openai | mock. Sin definir se infiere por el host
# de GUARDIAN_AI_BASE_URL (api.deepseek.com => deepseek; otro => openai).
# Modelos admitidos de DeepSeek: deepseek-flash, deepseek-v4-pro.
GUARDIAN_AI_PROVIDER=deepseek
GUARDIAN_AI_API_KEY=
GUARDIAN_AI_BASE_URL=https://api.deepseek.com/v1
GUARDIAN_AI_MODEL=deepseek-flash
GUARDIAN_AI_TIMEOUT_MS=20000
GUARDIAN_AI_MAX_TOKENS=900
GUARDIAN_AI_MAX_CONCURRENCY=2
GUARDIAN_AI_TOKENS_PER_COMPANY_DAY=200000
GUARDIAN_DIAGNOSIS_MAX_ATTEMPTS=4
GUARDIAN_CODE_ROOT=

# Operación, acceso de plataforma y workers
GUARDIAN_PLATFORM_TOKEN=
GUARDIAN_READER_DATABASE_URL=
GUARDIAN_WORKER_INTERVAL_SECONDS=5
GUARDIAN_WATCHDOG_DATABASE_URL=
GUARDIAN_WATCHDOG_WEBHOOK_URL=
GUARDIAN_WATCHDOG_WEBHOOK_TOKEN=
GUARDIAN_WATCHDOG_STATE_PATH=
GUARDIAN_WATCHDOG_STUCK_MINUTES=30
GUARDIAN_WATCHDOG_HEARTBEAT_MINUTES=10
GUARDIAN_WATCHDOG_REALERT_MINUTES=60
GUARDIAN_WATCHDOG_SEV1_MINUTES=60
GUARDIAN_WATCHDOG_WORKERS=alerts,diagnosis

# --- DOSA (proveedor e-CF) -------------------------------------------------
# Tres familias de credenciales SEPARADAS. No reutilizar una en el sitio de otra.
#
# 1) Webhook: HMAC sobre el cuerpo original (X-Dosa-Signature: t=...,v1=...).
DOSA_WEBHOOK_ENABLED=false
# BLOCKED (por defecto) | HMAC_SHA256_TIMESTAMPED | UNVERIFIED_PLAINTEXT_SECRET (solo laboratorio local)
DOSA_WEBHOOK_SIGNATURE_STRATEGY=BLOCKED
DOSA_WEBHOOK_SECRET=
# Cómo se interpretan los caracteres de DOSA_WEBHOOK_SECRET. PENDIENTE de confirmar.
#   utf8 (por defecto) -> los 64 caracteres son la clave tal cual
#   hex                -> los 64 caracteres codifican 32 bytes que son la clave
# Elegir mal hace que TODA firma se rechace (falla cerrado, pero sin pistas).
DOSA_WEBHOOK_SECRET_ENCODING=utf8
# Unidad del campo `t` de la cabecera. PENDIENTE de confirmar con el proveedor.
# Valor admitido: seconds | milliseconds. Por defecto seconds.
DOSA_WEBHOOK_TIMESTAMP_UNIT=seconds
# Ventana anti-replay en segundos (por defecto 300; techo 86400).
DOSA_WEBHOOK_TOLERANCE_SECONDS=300
#
# 2) Consultas: cabecera X-Dosa-Secret-Key con la clave secreta `sk_...`.
# Apagado por defecto: no hay endpoints de consulta confirmados.
DOSA_API_QUERIES_ENABLED=false
DOSA_SECRET_KEY=
DOSA_BASE_URL=
DOSA_QUERY_TIMEOUT_MS=15000
#
# 3) Emisión: cabecera X-API-KEY, misma ruta para TEST y produccion.
DOSA_TEST_API_KEY=
DOSA_PRODUCTION_API_KEY=
DOSA_EMISSION_ENABLED=false
DOSA_PRODUCTION_EMISSION_ENABLED=false

#
# APPYRA IA — puente del asistente flotante (servidor a servidor).
# Apagado por defecto: sin la bandera, /ai/chat se comporta exactamente como antes.
# El token se emite en APPYRA IA con POST /v1/integrations/keys (scopes agents:chat y
# agents:read) y se guarda SOLO en el entorno local del servidor de FullPOS.
APPYRA_IA_ENABLED=false
APPYRA_IA_BASE_URL=
APPYRA_IA_RUNTIME_TOKEN=
# Credencial con media:submit para reenviar imágenes y documentos al motor.
APPYRA_IA_MEDIA_TOKEN=
APPYRA_IA_PRODUCT_KEY=fullpos
APPYRA_IA_TIMEOUT_MS=60000
APPYRA_IA_MEDIA_TIMEOUT_MS=60000

# Contexto de empresa firmado (HMAC-SHA256) que FullPOS envía a APPYRA IA en la cabecera
# `x-appyra-company-context` para que el asistente sepa de qué empresa es el usuario sin aceptar
# un companyId suelto. Debe tener el MISMO valor que `APPYRA_COMPANY_CONTEXT_SECRET` de APPYRA.
# Sin esta variable el asistente sigue conversando, pero no abre ni consulta incidencias.
# Se genera una vez (32 bytes aleatorios en base64) y no se versiona ni se registra.
APPYRA_IA_COMPANY_CONTEXT_SECRET=

# ---------------------------------------------------------------------------
# Acceso al ASISTENTE e-CF (portal de certificación)
# ---------------------------------------------------------------------------
# La elegibilidad ya NO se decide por entorno: se guarda por empresa en
# `ecf_portal_enrollments` (autorización con autor, motivo, contrato y
# caducidad), gestionada desde /ecf/platform/dosa/portal-enrollments/:id.
#
# ECF_PORTAL_PILOT_COMPANY_IDS queda SOLO como compatibilidad: si un despliegue
# la tiene configurada, sus empresas siguen entrando mientras no exista fila en
# la tabla. No se usa para escribir nada y está declarada obsoleta.
ECF_PORTAL_PILOT_COMPANY_IDS=
#
# Inscripción automática del asistente: ENCENDIDA por defecto (opt-out).
# Con la regla activa, una empresa con e-CF habilitado e identidad fiscal
# registrada entra sola al asistente, sin que nadie la inscriba a mano. Es lo que
# permite que el cliente complete su trámite sin intervención de Fulltech.
#
# Poner `false` es el interruptor de emergencia: vuelve al comportamiento
# anterior (solo entra quien tenga una concesión registrada).
# Una empresa concreta se sigue bloqueando revocando su inscripción, porque una
# revocación gana siempre sobre esta regla.
ECF_PORTAL_AUTO_ENROLL_ENABLED=true

# ---------------------------------------------------------------------------
# Transporte de emisión DOSA
# ---------------------------------------------------------------------------
# FETCH (por defecto) usa el cliente HTTP real. FAKE usa un transporte que NO
# abre conexiones y devuelve una respuesta simulada: sirve para recorrer la
# cadena completa en UAT.
#
# FAKE sólo se acepta con APP_ENV=uat o UAT_LOCAL_ONLY=true. En cualquier otro
# entorno la aplicación NO ARRANCA (falla cerrado): un despliegue que herede la
# variable no puede quedar apuntando a un proveedor simulado en silencio.
# No sustituye a DOSA_EMISSION_ENABLED: con la emisión apagada la compuerta
# rechaza antes de llegar al transporte.
DOSA_EMISSION_TRANSPORT=FETCH
# Default closed. Enable only after reviewing the dedicated CRM management release.
CRM_LICENSE_MANAGEMENT_ENABLED=false
# Optional company activity measurements; requires the additive usage-pulses migration.
# Keep disabled until separately authorized. Existing statistics remain readable.
CRM_ACTIVITY_COLLECTION_ENABLED=false

# ---------------------------------------------------------------------------
# Avisos de licencia por WhatsApp (comprobantes de pago)
# ---------------------------------------------------------------------------
# Reutiliza la cuenta de WhatsApp Business ya existente: NO se crean
# credenciales nuevas. El cliente resuelve, en este orden:
#   LICENSE_WA_*  ->  GUARDIAN_WA_*  ->  WHATSAPP_*
# (token, numero emisor, version de Graph e idioma de la plantilla).
#
# DRY-RUN: es el unico estado permitido hasta que exista autorizacion explicita
# de envio real. Con `true` el aviso se compone y se registra en el log
# (`[DRY-RUN] WhatsApp <plantilla> -> <numero> ...`) sin salir a Meta.
# ATENCION: si esta variable falta, el aviso SE ENVIA de verdad.
LICENSE_WA_DRY_RUN=true
# Plantilla UTILITY con cabecera IMAGE aprobada por Meta (WABA "FULL TECH").
# Sustituye a `licencia_pago_por_verificar`, que no admite imagen.
LICENSE_WA_TEMPLATE_ADMIN_EVIDENCE=licencia_comprobante_soporte
# Activar SOLO con la plantilla en estado APPROVED: cambia el cuerpo de 5 a 10
# parametros. Con una plantilla de 5 y este flag en true, Meta devuelve 132000.
# LICENSE_WA_ADMIN_DETAILED=true
# Destinatario por defecto (administrador de FULLTECH, +1 809-398-7826).
# LICENSE_ADMIN_WHATSAPP=18093987826

# ---------------------------------------------------------------------------
# Planes, ordenes y comprobantes (sistema de cobro)
# ---------------------------------------------------------------------------
# La licencia solo cambia por el flujo de planes: catalogo -> orden -> subida del
# comprobante -> activacion. Ya NO existe autoservicio (`/license/activate`).
#
# Clave del puente administrativo (cabecera `x-license-admin-secret`). Sin ella,
# `/license/admin/*` y `/license/integrations/crm/*` responden 403 y no hay quien
# confirme ni rechace un pago. Generar con `npm run secrets:key` o similar: no
# escribirla en el repositorio.
# LICENSE_ADMIN_SECRET=
#
# Interruptor de gestion desde APPYRA CRM (comandos, excepciones y conciliacion
# de pagos). Apagado por defecto: activar solo cuando el CRM este listo.
CRM_LICENSE_MANAGEMENT_ENABLED=false
#
# Datos de la cuenta para transferencias. Si faltan, se usan los comerciales de
# FULLTECH escritos en el codigo; cambiar aqui cuando cambien.
# LICENSE_BANK_HOLDER=FULLTECH, SRL
# LICENSE_BANK_HOLDER_TAX_ID=133080206
# LICENSE_BANK_ACCOUNT=841360753
# LICENSE_BANK_NAME=
# LICENSE_BANK_ACCOUNT_TYPE=Ahorro o corriente
#
# Comprobantes: carpeta PRIVADA (nunca bajo /uploads) y tope por archivo.
# Si se usa el driver local, montar un volumen persistente: sin el, los
# comprobantes locales se pierden en el siguiente despliegue.
# LICENSE_EVIDENCE_DIR=/data/license-evidence
# Escrituras opt-in en R2 privado; local conserva el comportamiento anterior.
LICENSE_EVIDENCE_STORAGE_DRIVER=local
# Bucket dedicado, diferente de R2_BUCKET/R2_BUCKET_NAME, sin acceso publico.
# Reutiliza endpoint/credenciales R2 del servidor, con acceso al bucket privado.
# LICENSE_EVIDENCE_R2_BUCKET=fullpos-private-license-evidence
# Las lecturas locales antiguas mantienen LICENSE_EVIDENCE_DIR.
# No cambiar el bucket privado despues de guardar recibos sin un traslado verificado.
#
# Activacion provisional: dias que puede estar una activacion sin verificar y
# que hacer al cumplirse (`keep` no corta el servicio; `revert` lo revoca).
LICENSE_PROVISIONAL_DAYS=15
LICENSE_PROVISIONAL_EXPIRY_ACTION=keep
#
# Lectura del comprobante (OCR). **Sin motor configurado NO hay activacion
# automatica**: cada pago queda pendiente de revision manual.
#
# La licencia NUNCA se activa sin leer el comprobante (banco, referencia,
# importe exacto, cuenta destino y fecha). No existe variable para saltarse esa
# lectura: cualquier imagen valida que la saltara activaba el plan sin pagar.
# `LICENSE_EVIDENCE_REQUIRE_ANALYSIS=true` exige ademas que el analisis de
# importe este disponible para activar.
#
# Desfase horario con el que el comprobante escribe la hora (Republica
# Dominicana = -4). Si se leyera como UTC, un pago de las 22:30 pareceria del
# dia anterior y no activaria.
LICENSE_RECEIPT_UTC_OFFSET_HOURS=-4
# Motor local de APPYRA (sin IA de pago):
# APPYRA_MEDIA_PYTHON=C:\ruta\al\python.exe
# APPYRA_MEDIA_WORKER=C:\ruta\media_worker.py
# o por HTTP:
# APPYRA_MEDIA_BASE_URL=http://127.0.0.1:4300
# APPYRA_MEDIA_TOKEN=
# APPYRA_MEDIA_OCR_PATH=/v1/media/ocr
# Para el contrato real de APPYRA Media Engine (/v1/media + trabajos):
# APPYRA_MEDIA_OCR_PROTOCOL=appyra-jobs
# Requiere token de integracion con media:submit y media:read, ligado a la
# empresa de cobros. No se usan credenciales fiscales DOSA de clientes.
# Sin esta seleccion se conserva el adaptador HTTP sincrono anterior.
# APPYRA_MEDIA_OCR_TIMEOUT_MS=120000
# APPYRA_MEDIA_OCR_LANGS=es,en
#
# Cuenta de WhatsApp para los avisos (reutiliza la de Guardian/app):
# LICENSE_WA_TOKEN=
# LICENSE_WA_PHONE_NUMBER_ID=
