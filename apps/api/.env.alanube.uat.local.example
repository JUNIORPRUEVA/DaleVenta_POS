# Alanube Sandbox local configuration template.
# Copy to apps/api/.env.alanube.uat.local and keep the copy private.
# Do not paste real tokens, portal passwords, private keys, or certificates here.

ALANUBE_ENV=sandbox
ALANUBE_BASE_URL=https://sandbox.alanube.co/dom/v1
ALANUBE_ENABLE_REAL_CALLS=false

# Reference only. The UAT wrapper can load a local encrypted token into this
# process variable without making it global for Windows or other projects.
# Do not use the Alanube portal password as an API credential.
ALANUBE_TOKEN_SECRET_REF=env://ALANUBE_SANDBOX_TOKEN

# Optional operator references. These are identifiers/references, not secrets.
ALANUBE_RESELLER_ACCOUNT_REF=
# Accepted values: alanube-sandbox-attachment, local-dpapi-securestring,
# operator-vault, windows-credential-manager, company-secret-manager,
# manual-pending.
ALANUBE_CREDENTIAL_SOURCE=local-dpapi-securestring

# Test fiscal profile received from Alanube. These values must remain local to
# this workstation until the official contract and tenant onboarding are verified.
ALANUBE_TEST_RNC=132109122
ALANUBE_TEST_SEQUENCE_PREFIX=
ALANUBE_TEST_SEQUENCE_FROM=9805001
ALANUBE_TEST_SEQUENCE_TO=9806000
ALANUBE_TEST_SEQUENCE_EXPIRES_ON=2028-12-31

# Safety flags for this phase. Keep both disabled until a later approved phase.
ECF_EMISSION_ENABLED=false
ECF_ALANUBE_AUTH_TESTS_ENABLED=false
