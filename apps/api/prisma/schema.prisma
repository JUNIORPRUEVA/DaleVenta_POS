model Company {
  id                      String         @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String         @unique
  status                  CompanyStatus  @default(ACTIVE)
  plan                    CompanyPlan    @default(STANDARD)
  licenseStatus           LicenseStatus  @default(TRIAL) @map("license_status")
  licenseKey              String?        @unique @map("license_key")
  trialStartedAt          DateTime?      @default(now()) @map("trial_started_at")
  trialEndsAt             DateTime?      @map("trial_ends_at")
  licenseActivatedAt      DateTime?      @map("license_activated_at")
  licenseExpiresAt        DateTime?      @map("license_expires_at")
  licenseBlockedAt        DateTime?      @map("license_blocked_at")
  licenseNotes            String?        @map("license_notes") @db.Text
  maxUsers                Int            @default(2) @map("max_users")
  maxProducts             Int            @default(100) @map("max_products")
  taxEnabled              Boolean        @default(false) @map("tax_enabled")
  defaultTaxId            String?        @map("default_tax_id") @db.Uuid
  defaultTaxRate          Decimal        @default(0) @map("default_tax_rate") @db.Decimal(5, 4)
  pricesIncludeTax        Boolean        @default(false) @map("prices_include_tax")
  ncfEnabled              Boolean        @default(false) @map("ncf_enabled")
  measurementUnitsEnabled Boolean        @default(false) @map("measurement_units_enabled")
  multiWarehouseEnabled   Boolean        @default(false) @map("multi_warehouse_enabled")
  productSource           ProductSource? @map("product_source")
  fullposCompanyId        String?        @map("fullpos_company_id")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  users                            User[]
  appConfigs                       AppConfig[]
  members                          CompanyMember[]
  AuthSession                      AuthSession[]
  passwordResetTokens              PasswordResetToken[]
  passwordResetAuditLogs           PasswordResetAuditLog[]
  licenseAuditLogs                 CompanyLicenseAuditLog[]
  products                         Product[]
  unitOfMeasures                   UnitOfMeasure[]
  suppliers                        Supplier[]
  purchaseInvoices                 PurchaseInvoice[]
  purchaseOrders                   PurchaseOrder[]
  clients                          Client[]
  sales                            Sale[]
  saleCreditPayments               SaleCreditPayment[]
  cashboxDailies                   CashboxDaily[]
  cashSessions                     CashSession[]
  cashMovements                    CashMovement[]
  closes                           Close[]
  depositOrders                    DepositOrder[]
  depositBanks                     DepositBank[]
  fiscalInvoices                   FiscalInvoice[]
  ncfSequences                     NcfSequence[]
  ncfAuditLogs                     NcfAuditLog[]
  taxes                            Tax[]
  payableServices                  PayableService[]
  payablePayments                  PayablePayment[]
  payrollEmployees                 PayrollEmployee[]
  payrollPeriods                   PayrollPeriod[]
  payrollEmployeeConfigs           PayrollEmployeeConfig[]
  payrollEntries                   PayrollEntry[]
  payrollEmployeePeriodStatuses    PayrollEmployeePeriodStatus[]
  payrollServiceCommissionRequests PayrollServiceCommissionRequest[]
  warrantyProductConfigs           WarrantyProductConfig[]
  cotizaciones                     Cotizacion[]
  openSalesTicketState             OpenSalesTicketState?
  workScheduleProfiles             WorkScheduleProfile[]
  workCoverageRules                WorkCoverageRule[]
  workEmployeeConfigs              WorkEmployeeConfig[]
  workScheduleExceptions           WorkScheduleException[]
  workWeekSchedules                WorkWeekSchedule[]
  workScheduleAuditLogs            WorkScheduleAuditLog[]
  aiAssistantConversationTurns     AiAssistantConversationTurn[]
  aiAssistantMemories              AiAssistantMemory[]
  warehouses                       Warehouse[]
  warehouseStocks                  WarehouseStock[]
  terminals                        Terminal[]
  inventoryMovements               InventoryMovement[]
  warehouseTransfers               WarehouseTransfer[]
  warehouseTransferItems           WarehouseTransferItem[]
  inventoryZeroConfigState         InventoryZeroConfigState?

  @@index([status])
  @@index([licenseStatus])
  @@index([licenseExpiresAt])
  @@index([productSource], map: "Company_product_source_idx")
  @@map("companies")
}

model OpenSalesTicketState {
  companyId       String   @id @map("company_id") @db.Uuid
  activeTicketId  String?  @map("active_ticket_id")
  tickets         Json     @default("[]")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("open_sales_ticket_states")
}

model CompanyLicenseAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email")
  action     String
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([action])
  @@map("company_license_audit_logs")
}

model CompanyMember {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  companyId String              @map("company_id") @db.Uuid
  role      CompanyMemberRole   @default(VIEWER)
  status    CompanyMemberStatus @default(ACTIVE)
  invitedBy String?             @map("invited_by") @db.Uuid
  joinedAt  DateTime?           @default(now()) @map("joined_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter User?   @relation("CompanyMemberInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([userId, status])
  @@index([companyId, role])
  @@map("company_members")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  tokenFamily      String    @map("token_family") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([companyId, revokedAt])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model User {
  id                           String    @id @default(uuid()) @db.Uuid
  companyId                    String?   @map("company_id") @db.Uuid
  email                        String    @unique
  passwordHash                 String
  nombreCompleto               String
  telefono                     String
