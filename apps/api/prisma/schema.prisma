model Cotizacion {
  id                      String       @id @default(uuid()) @db.Uuid
  companyId               String       @map("company_id") @db.Uuid
  createdByUserId         String       @db.Uuid
  customerId              String?      @db.Uuid
  customerName            String
  customerPhone           String
  customerPhoneNormalized String       @default("")
  note                    String?
  includeItbis            Boolean      @default(false)
  itbisRate               Decimal      @default(0.18) @db.Decimal(5, 4)
  fiscalTaxEnabled        Boolean      @default(false) @map("fiscal_tax_enabled")
  fiscalPriceMode         TaxPriceMode @default(NO_TAX) @map("fiscal_price_mode")
  taxableBase             Decimal      @default(0) @map("taxable_base") @db.Decimal(12, 2)
  taxAmount               Decimal      @default(0) @map("tax_amount") @db.Decimal(12, 2)
  exemptAmount            Decimal      @default(0) @map("exempt_amount") @db.Decimal(12, 2)
  discountAmount          Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  globalDiscountAmount    Decimal      @default(0) @db.Decimal(12, 2)
  subtotal                Decimal      @db.Decimal(12, 2)
  subtotalCost            Decimal?     @db.Decimal(12, 2)
  itbisAmount             Decimal      @db.Decimal(12, 2)
  totalCost               Decimal?     @db.Decimal(12, 2)
  total                   Decimal      @db.Decimal(12, 2)
  totalProfit             Decimal?     @db.Decimal(12, 2)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  createdBy     User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  customer      Client?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         CotizacionItem[]
  serviceOrders ServiceOrder[]
  sourceSales   Sale[]
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
  @@index([customerId])
  @@index([companyId, customerPhone])
  @@index([companyId, customerPhoneNormalized])
  @@index([companyId, createdAt])
}

model CotizacionItem {
  id                        String              @id @default(uuid()) @db.Uuid
  cotizacionId              String              @db.Uuid
  productId                 String?             @db.Uuid
  productSource             ProductSource?      @map("product_source")
  sourceProductId           String?             @map("source_product_id")
  productNameSnapshot       String
  productImageSnapshot      String?
  qty                       Decimal             @db.Decimal(18, 6)
  unitCodeSnapshot          String              @default("UNIT") @map("unit_code_snapshot") @db.VarChar(32)
  unitNameSnapshot          String              @default("Unidad") @map("unit_name_snapshot")
  unitSymbolSnapshot        String              @default("u") @map("unit_symbol_snapshot") @db.VarChar(16)
  unitPrecisionSnapshot     Int                 @default(0) @map("unit_precision_snapshot")
  originalUnitPriceSnapshot Decimal?            @db.Decimal(12, 2)
  unitPrice                 Decimal             @db.Decimal(12, 2)
  costUnitSnapshot          Decimal?            @db.Decimal(12, 2)
  subtotalCost              Decimal?            @db.Decimal(12, 2)
  taxTreatment              ProductTaxTreatment @default(INHERIT) @map("tax_treatment")
  taxPriceMode              TaxPriceMode        @default(NO_TAX) @map("tax_price_mode")
  grossAmount               Decimal             @default(0) @map("gross_amount") @db.Decimal(12, 2)
  lineDiscountAmount        Decimal             @default(0) @map("line_discount_amount") @db.Decimal(12, 2)
  taxableBase               Decimal             @default(0) @map("taxable_base") @db.Decimal(12, 2)
  taxRate                   Decimal             @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount                 Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  exemptAmount              Decimal             @default(0) @map("exempt_amount") @db.Decimal(12, 2)
  taxIncluded               Boolean             @default(false) @map("tax_included")
  taxExempt                 Boolean             @default(false) @map("tax_exempt")
  lineTotal                 Decimal             @db.Decimal(12, 2)
  profit                    Decimal?            @db.Decimal(12, 2)
  createdAt                 DateTime            @default(now())

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([cotizacionId])
  @@index([productId])
  @@index([productSource, sourceProductId], map: "cotizacion_items_product_source_source_product_id_idx")
}

model WorkScheduleProfile {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days            WorkScheduleProfileDay[]
  employeeConfigs WorkEmployeeConfig[]
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isDefault])
  @@map("work_schedule_profiles")
}

model WorkScheduleProfileDay {
  id          String        @id @default(uuid()) @db.Uuid
  profileId   String        @map("profile_id") @db.Uuid
  weekday     Int // 0=Mon ... 6=Sun
  isWorking   Boolean       @default(true) @map("is_working")
  kind        WorkShiftKind @default(NORMAL)
  startMinute Int           @map("start_minute")
  endMinute   Int           @map("end_minute")

  profile WorkScheduleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, weekday])
  @@index([weekday])
  @@map("work_schedule_profile_days")
}

model WorkCoverageRule {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  role        Role
  weekday     Int // 0=Mon ... 6=Sun
  minRequired Int      @default(0) @map("min_required")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role, weekday])
  @@index([companyId, weekday])
  @@map("work_coverage_rules")
}

model WorkEmployeeConfig {
  id                        String   @id @default(uuid()) @db.Uuid
  companyId                 String   @map("company_id") @db.Uuid
  userId                    String   @unique @map("user_id") @db.Uuid
  enabled                   Boolean  @default(true)
  scheduleProfileId         String?  @map("schedule_profile_id") @db.Uuid
  preferredDayOffWeekday    Int?     @map("preferred_day_off_weekday")
  fixedDayOffWeekday        Int?     @map("fixed_day_off_weekday")
  disallowedDayOffWeekdays  Int[]    @default([]) @map("disallowed_day_off_weekdays")
  unavailableWeekdays       Int[]    @default([]) @map("unavailable_weekdays")
  notes                     String?
  lastAssignedDayOffWeekday Int?     @map("last_assigned_day_off_weekday")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleProfile WorkScheduleProfile?    @relation(fields: [scheduleProfileId], references: [id], onDelete: SetNull)
  exceptions      WorkScheduleException[]
  assignments     WorkDayAssignment[]

  @@index([enabled])
  @@index([companyId, enabled])
  @@index([scheduleProfileId])
  @@map("work_employee_configs")
}

model WorkScheduleException {
  id            String                    @id @default(uuid()) @db.Uuid
  companyId     String                    @map("company_id") @db.Uuid
  userId        String?                   @map("user_id") @db.Uuid
  type          WorkScheduleExceptionType
  dateFrom      DateTime                  @map("date_from")
  dateTo        DateTime                  @map("date_to")
  note          String?
  createdById   String?                   @map("created_by_id") @db.Uuid
  createdByName String?                   @map("created_by_name")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeConfig WorkEmployeeConfig? @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([companyId, dateFrom, dateTo])
  @@index([userId])
  @@index([type])
  @@index([dateFrom, dateTo])
  @@map("work_schedule_exceptions")
}

model WorkWeekSchedule {
  id              String                 @id @default(uuid()) @db.Uuid
  companyId       String                 @map("company_id") @db.Uuid
  weekStartDate   DateTime               @map("week_start_date")
  status          WorkWeekScheduleStatus @default(GENERATED)
  generatedById   String?                @map("generated_by_id") @db.Uuid
  generatedByName String?                @map("generated_by_name")
  generatedAt     DateTime               @default(now()) @map("generated_at")
  warnings        Json? // array of strings/objects
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  days    WorkDayAssignment[]
  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStartDate])
  @@index([companyId, generatedAt])
