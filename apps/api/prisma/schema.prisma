  id                String    @id @default(uuid()) @db.Uuid
  serviceId         String    @db.Uuid
  uploadedByUserId  String    @db.Uuid
  fileUrl           String
  fileType          String
  caption           String?
  storageProvider   String    @default("LOCAL")
  objectKey         String?
  originalFileName  String?
  mimeType          String?
  mediaType         String?
  kind              String?
  fileSize          Int?
  width             Int?
  height            Int?
  durationSeconds   Int?
  executionReportId String?   @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  service         Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploadedBy      User                    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  executionReport ServiceExecutionReport? @relation(fields: [executionReportId], references: [id], onDelete: SetNull)

  serviceClosingSignatureFor        ServiceClosing[] @relation("ServiceClosingSignatureFile")
  serviceClosingInvoiceDraftFor     ServiceClosing[] @relation("ServiceClosingInvoiceDraftFile")
  serviceClosingWarrantyDraftFor    ServiceClosing[] @relation("ServiceClosingWarrantyDraftFile")
  serviceClosingInvoiceApprovedFor  ServiceClosing[] @relation("ServiceClosingInvoiceApprovedFile")
  serviceClosingWarrantyApprovedFor ServiceClosing[] @relation("ServiceClosingWarrantyApprovedFile")
  serviceClosingInvoiceFinalFor     ServiceClosing[] @relation("ServiceClosingInvoiceFinalFile")
  serviceClosingWarrantyFinalFor    ServiceClosing[] @relation("ServiceClosingWarrantyFinalFile")

  @@index([serviceId])
  @@index([serviceId, createdAt])
  @@index([serviceId, kind])
  @@index([executionReportId])
  @@index([uploadedByUserId])
}

model ServiceOrder {
  id                        String               @id @default(uuid()) @db.Uuid
  clientId                  String               @map("client_id") @db.Uuid
  quotationId               String?              @map("quotation_id") @db.Uuid
  category                  ServiceOrderCategory
  serviceType               ServiceOrderType     @map("service_type")
  status                    ServiceOrderStatus   @default(PENDIENTE)
  scheduledFor              DateTime?            @map("scheduled_for")
  finalizedAt               DateTime?            @map("finalized_at")
  technicianConfirmedAt     DateTime?            @map("technician_confirmed_at")
  technicianConfirmedById   String?              @map("technician_confirmed_by") @db.Uuid
  technicalNote             String?              @map("technical_note") @db.Text
  extraRequirements         String?              @map("extra_requirements") @db.Text
  parentOrderId             String?              @map("parent_order_id") @db.Uuid
  createdById               String               @map("created_by") @db.Uuid
  assignedToId              String?              @map("assigned_to") @db.Uuid
  lastStatusChangedAt       DateTime             @default(now()) @map("last_status_changed_at")
  lastStatusChangedByUserId String?              @map("last_status_changed_by_user_id") @db.Uuid
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  client                           Client                            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quotation                        Cotizacion?                       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  parentOrder                      ServiceOrder?                     @relation("ServiceOrderParent", fields: [parentOrderId], references: [id], onDelete: SetNull)
  childOrders                      ServiceOrder[]                    @relation("ServiceOrderParent")
  createdBy                        User                              @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo                       User?                             @relation("ServiceOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastStatusChangedBy              User?                             @relation("ServiceOrderLastStatusChangedBy", fields: [lastStatusChangedByUserId], references: [id], onDelete: SetNull)
  technicianConfirmedBy            User?                             @relation("ServiceOrderConfirmedBy", fields: [technicianConfirmedById], references: [id], onDelete: SetNull)
  evidences                        ServiceEvidence[]
  reports                          ServiceReport[]
  statusHistory                    ServiceOrderStatusHistory[]
  payrollServiceCommissionRequests PayrollServiceCommissionRequest[]
  notificationJobs                 ServiceOrderNotificationJob[]

  @@index([clientId])
  @@index([quotationId])
  @@index([category])
  @@index([serviceType])
  @@index([status])
  @@index([scheduledFor])
  @@index([finalizedAt])
  @@index([createdById])
  @@index([assignedToId])
  @@index([lastStatusChangedAt])
  @@index([lastStatusChangedByUserId])
  @@index([technicianConfirmedById])
  @@index([parentOrderId])
  @@index([status, assignedToId])
  @@index([status, lastStatusChangedAt])
  @@index([clientId, createdAt])
  @@map("service_orders")
}

model ServiceOrderStatusHistory {
