---
import { site } from '../config/site';

const apiBase = (import.meta.env.PUBLIC_API_BASE_URL ?? '/api').replace(/\/+$/, '');
const appUrl = import.meta.env.PUBLIC_APP_URL ?? '/';

/*
 * Réplica web del splash real de Flutter
 * (`apps/fulltech_app/lib/features/splash/splash_screen.dart`):
 * mismo fondo, mismo anillo girando, mismo logo, mismos textos y misma barra.
 *
 * Mientras se muestra, se pide el ticket de handoff y se abre la PWA, que
 * arranca con su bienvenida y su onboarding.
 */

const RING = 196;
const CENTER = RING / 2;
const RADIUS = CENTER - 8;
const CIRC = 2 * Math.PI * RADIUS;
const ARC = CIRC * (256 / 360); // el splash pinta 1.42π radianes

/* 20 marcas pequeñas girando dentro del anillo */
const ticks = Array.from({ length: 20 }, (_, i) => {
  const angle = ((Math.PI * 2) / 20) * i;
  const inner = RADIUS - 16;
  const outer = RADIUS - 10;
  return {
    x1: (CENTER + Math.cos(angle) * inner).toFixed(2),
    y1: (CENTER + Math.sin(angle) * inner).toFixed(2),
    x2: (CENTER + Math.cos(angle) * outer).toFixed(2),
    y2: (CENTER + Math.sin(angle) * outer).toFixed(2),
  };
});

/* 7 curvas suaves de fondo, como en `_BackgroundLinesPainter` */
const lines = Array.from({ length: 7 }, (_, i) => {
  const y = 1000 * (0.18 + i * 0.105);
  return `M -30 ${y} C 280 ${y - 34}, 620 ${y + 34}, 1030 ${y - 8}`;
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preparando tu cuenta · {site.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F8FAFC" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #f8fafc;
        color: #0f172a;
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* ---------- Fondo: gradiente + curvas ---------- */
      .splash-bg {
        position: fixed;
        inset: 0;
        background: linear-gradient(
          to bottom,
          #eff6ff 0%,
          #f8fafc 58%,
          #f7fee7 100%
        );
      }

      .splash-lines {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      /* ---------- Contenido ---------- */
      .splash {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100dvh;
        max-width: 440px;
        margin: 0 auto;
        padding: 0 24px;
        text-align: center;
        animation: splash-intro 1800ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes splash-intro {
        0% {
          opacity: 0;
          transform: translateY(18px) scale(0.94);
        }
        62%,
        100% {
          opacity: 1;
          transform: none;
        }
      }

      .splash-ring {
        position: relative;
        width: var(--ring);
        height: var(--ring);
        display: grid;
        place-items: center;
      }

      .splash-ring > svg,
      .splash-ring > div {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      /* La rotación ocurre sobre un contenedor HTML: gira siempre sobre el
         centro exacto del logo. */
      .ring-arc-spin {
        animation: arc-orbit 1800ms linear infinite;
      }

      .ring-ticks-spin {
        animation: ring-spin 2250ms linear infinite;
      }

      @keyframes arc-orbit {
        from {
          transform: rotate(-90deg);
        }
        to {
          transform: rotate(270deg);
        }
      }

      @keyframes ring-spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      .splash-logo {
        width: var(--logo);
        height: var(--logo);
        object-fit: contain;
        animation: logo-pulse 1800ms ease-in-out infinite;
      }

      @keyframes logo-pulse {
        0%,
        100% {
          transform: scale(0.985);
        }
        50% {
          transform: scale(1.015);
        }
      }

      .splash-name {
        margin: 20px 0 0;
        font-size: 23px;
        font-weight: 900;
        color: #0f172a;
        letter-spacing: 0;
      }

      .splash-state {
        margin: 6px 0 0;
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
      }

      /* ---------- Barra ---------- */
      .splash-track {
        position: relative;
        width: 170px;
        height: 4px;
        margin-top: 18px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
      }

      .splash-track span {
        position: absolute;
        inset: 0 auto 0 0;
        width: 38%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb 0%, #14b8a6 100%);
        animation: track-run 1800ms linear infinite;
      }

      @keyframes track-run {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(263%);
        }
      }

      /* ---------- Solo si algo falla ---------- */
      .splash-actions {
        display: grid;
        gap: 10px;
        width: min(280px, 100%);
        margin-top: 22px;
      }

      .splash-actions[hidden] {
        display: none;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 20px;
        border: 1px solid transparent;
        border-radius: 10px;
        font: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      .btn-primary {
        color: #fff;
        background: linear-gradient(135deg, #2a6bff 0%, #2563eb 42%, #1d4ed8 100%);
      }

      .btn-ghost {
        color: #0f172a;
        background: #fff;
        border-color: #dde2ea;
      }

      :root {
        --ring: 196px;
        --logo: 146px;
      }

      /* Mismo criterio que Flutter: compacto si es estrecho o bajo */
      @media (max-width: 559px), (max-height: 679px) {
        :root {
          --ring: 154px;
          --logo: 116px;
        }

        .splash-name {
          margin-top: 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .splash,
        .splash-logo {
          animation: none;
        }

        .ring-arc {
          animation-duration: 4s;
        }

        .ring-ticks {
          animation-duration: 5s;
        }

        .splash-track span {
          animation-duration: 3s;
        }
      }
    </style>
  </head>

  <body>
    <div class="splash-bg" aria-hidden="true">
      <svg class="splash-lines" viewBox="0 0 1000 1000" preserveAspectRatio="none">
        {lines.map((d) => <path d={d} fill="none" stroke="#1D4ED8" stroke-opacity="0.055" stroke-width="1" />)}
      </svg>
    </div>

    <main class="splash" role="status" aria-live="polite" data-prepare-root data-api={apiBase} data-app-url={appUrl}>
      <div class="splash-ring">
        <svg viewBox={`0 0 ${RING} ${RING}`} aria-hidden="true">
          <circle cx={CENTER} cy={CENTER} r={RADIUS} fill="none" stroke="#E2E8F0" stroke-width="1.6" />
        </svg>

        <div class="ring-ticks-spin">
          <svg viewBox={`0 0 ${RING} ${RING}`} aria-hidden="true">
            <g stroke="#2563EB" stroke-opacity="0.16" stroke-width="1" stroke-linecap="round">
              {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
            </g>
          </svg>
        </div>

        <div class="ring-arc-spin">
          <svg viewBox={`0 0 ${RING} ${RING}`} aria-hidden="true">
            <defs>
              <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#2563EB" stop-opacity="0" />
                <stop offset="46%" stop-color="#2563EB" />
                <stop offset="78%" stop-color="#14B8A6" />
                <stop offset="100%" stop-color="#14B8A6" stop-opacity="0" />
              </linearGradient>
            </defs>

            <circle
              cx={CENTER}
              cy={CENTER}
              r={RADIUS}
              fill="none"
              stroke="url(#ringGrad)"
              stroke-width="3.2"
              stroke-linecap="round"
              stroke-dasharray={`${ARC.toFixed(2)} ${CIRC.toFixed(2)}`}
            />
          </svg>
        </div>

        <img class="splash-logo" src="/logo-splash.png" alt="" width="146" height="146" />
      </div>

      <p class="splash-name">{site.name}</p>

      <p class="splash-state" data-prepare-status>
        Estamos creando tu cuenta, espera un momento…
      </p>

      <div class="splash-track" aria-hidden="true"><span></span></div>

      <div class="splash-actions" data-prepare-actions hidden>
        <button type="button" class="btn btn-primary" data-prepare-retry>Reintentar</button>
        <a class="btn btn-ghost" href="/login">Volver al acceso</a>
      </div>
    </main>

    <script>
      import { getAccessToken } from '../scripts/site-session';

      const root = document.querySelector<HTMLElement>('[data-prepare-root]');

      if (root) {
        const apiBase = (root.dataset.api ?? '/api').replace(/\/+$/, '');
        const appUrl = root.dataset.appUrl ?? '/';
        const statusEl = root.querySelector<HTMLElement>('[data-prepare-status]')!;
        const actionsEl = root.querySelector<HTMLElement>('[data-prepare-actions]')!;
        const retryBtn = root.querySelector<HTMLButtonElement>('[data-prepare-retry]')!;

        let busy = false;

        const fail = (message: string): void => {
          statusEl.textContent = message;
          actionsEl.hidden = false;
        };

        const run = async (): Promise<void> => {
          if (busy) return;
          busy = true;
          actionsEl.hidden = true;
          statusEl.textContent = 'Estamos creando tu cuenta, espera un momento…';

          try {
            const token = await getAccessToken(apiBase);
            if (!token) {
              fail('No encontramos tu sesión. Inicia sesión para continuar.');
              return;
            }

            const response = await fetch(`${apiBase}/auth/handoff/ticket`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Authorization: `Bearer ${token}`,
              },
              body: JSON.stringify({ platform: 'web' }),
            });

            if (response.status === 401 || response.status === 403) {
              fail('Tu sesión expiró. Inicia sesión de nuevo.');
              return;
            }
            if (!response.ok) throw new Error('handoff');

            const payload = (await response.json().catch(() => ({}))) as { ticket?: string };
            const ticket = (payload.ticket ?? '').trim();
            if (!ticket) throw new Error('ticket');

            statusEl.textContent = 'Abriendo FullPOS…';

            const target = new URL(appUrl, window.location.origin);
            target.searchParams.set('handoff', ticket);
            window.location.assign(target.toString());
          } catch {
            fail(
              'No pudimos conectar con el servidor. Tu cuenta ya está creada, no hace falta registrarte otra vez.',
            );
          } finally {
            busy = false;
          }
        };

        retryBtn.addEventListener('click', () => void run());
        void run();
      }
    </script>
  </body>
</html>
