---
import { site, cta } from '../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/precios', label: 'Precios' },
  { href: '/funciones', label: 'Funciones' },
  { href: '/descargas', label: 'Descargas' },
  { href: '/soporte', label: 'Soporte' },
  { href: '/#faq', label: 'FAQ' },
];

const isCurrent = (href: string) => path === href;
---

<header class="site-header">
  <aside class="fiscal-announcement" aria-label="Facturación electrónica disponible">
    <span class="fiscal-status" aria-hidden="true"></span>
    <span>Facturación electrónica disponible</span>
  </aside>
  <nav class="nav container" aria-label="Navegación principal">
    <a class="brand" href="/" aria-label={`${site.name}, inicio`}>
      <img
        class="brand-logo"
        src="/img/logo.webp"
        alt=""
        width="40"
        height="40"
        decoding="async"
      />
      <span class="brand-text">
        <strong>{site.name}</strong>
        <span class="brand-by">{site.byline}</span>
      </span>
    </a>

    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <a class="btn btn-quiet btn-sm" href="/login">{cta.header.login}</a>
      <a class="btn btn-ghost btn-sm nav-dl" href="/descargas">Descargas</a>
      <a class="btn btn-primary btn-sm nav-signup" href="/registro">Registrarse</a>
      <button
        class="nav-toggle"
        type="button"
        popovertarget="site-menu"
        aria-label="Abrir menú"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Menú móvil con Popover API: cierre con Esc, clic fuera o botón explícito. -->
<div id="site-menu" popover class="menu" aria-label="Menú">
  <div class="menu-heading">
    <strong>Menú</strong>
    <button class="nav-toggle" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <nav class="menu-links" aria-label="Navegación móvil">
    {links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
    <a href="/login">{cta.header.login}</a>
  </nav>
  <div class="menu-cta">
    <a class="btn btn-primary btn-block" href="/registro">{cta.header.primary}</a>
    <a class="btn btn-ghost btn-block" href="/precios">Ver planes y precios</a>
  </div>
</div>

<script>
  // Los enlaces a secciones de la misma página también deben cerrar el menú.
  const menu = document.querySelector<HTMLElement>('#site-menu');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) menu.hidePopover();
  });
</script>
